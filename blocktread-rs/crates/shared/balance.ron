// Every number that decides how strong a block is, and the global balance knobs.
//
// Built into the program. To try changes without rebuilding, point BLOCKTREAD_BALANCE at a copy of
// this file (client, server and the duel simulator all read it). Clients and servers must agree:
// the file's hash is checked when a player joins.
(
    // ---- global knobs ----
    // multiplies every weapon's damage and every block's hit points (time-to-kill tuning)
    damage_scale: 1.1,
    hp_scale: 1.0,
    // a ship's own energy before reactors and capacitors
    base_energy_cap: 60.0,
    base_energy_regen: 15.0,
    // damage left after a piercing round goes through a block
    pierce_falloff: 0.7,

    // ---- damage ----
    // a cockpit's hit points grow with what the ship cost, so big ships aren't one lucky shot
    cockpit_hp_per_cost: 0.6,
    // a ship falls apart when its blocks have less than this share of their hit points left
    collapse_below: 0.25,
    // what shields take from each kind of hit
    shield_vs: { Energy: 0.5, Kinetic: 1.0, Pierce: 1.0, Explosive: 1.5 },
    // how much of a block's armour each kind of hit meets; armour comes off every hit
    armor_vs: { Energy: 0.0, Kinetic: 1.0, Pierce: 0.2, Explosive: 0.0 },
    // armour never takes a hit below this share of its damage
    min_damage_share: 0.3,
    // an explosion deals at most this many times its damage, shared over the blocks it reaches
    splash_total: 2.0,

    // ---- build budget ----
    // a ship's cost is the sum of its blocks' costs; each further weapon makes every weapon on
    // the ship this much dearer, so walls of guns cost more than the guns
    weapon_cost_growth: 0.04,
    // rooms can be limited to a tier: ships over its budget can't join
    tiers: [
        (key: "light", name: "轻型", budget: 80.0),
        (key: "medium", name: "中型", budget: 160.0),
        (key: "heavy", name: "重型", budget: 350.0),
    ],

    blocks: {
        Cockpit: (name: "驾驶室", cat: Core, mass: 2.0, hp: 45.0, cost: 0.0, color: 0xe6ebf1,
            info: "必需，只能有 1 个。顶部或正前方至少一个方向视野通畅。被打掉整辆车就报废。"),
        Engine: (name: "推进器", cat: Mobility, mass: 2.0, hp: 28.0, cost: 6.0, color: 0x6b7380, thrust: 26.0,
            info: "按 W 就往前推：车轮车起步更猛，悬浮车全靠它走。按住 Shift 全力喷火，推力翻倍，很耗能量；能量耗尽后要停 1 秒，并且松开 Shift 再按才能再加速。只能往前推，尾喷口正后方必须空着。"),
        Hull: (name: "车体", cat: Structure, mass: 1.0, hp: 22.0, cost: 1.0, color: 0xb9c3cf,
            info: "轻型结构块，用来连接和塑形。"),
        Armor: (name: "装甲", cat: Structure, mass: 3.0, hp: 75.0, cost: 4.0, color: 0x59626d, armor: 3.0,
            info: "很耐打，每次被动能武器（机炮、霰弹）击中还能挡掉几点伤害；但很重：拖慢速度，装得高还会抬高重心。"),
        Laser: (name: "激光炮", cat: Weapon, mass: 1.5, hp: 18.0, cost: 11.0, color: 0x8a939e,
            info: "弹速快、射速高，每发消耗能量。",
            weapon: Some((kind: Energy, rate: 5.0, dmg: 8.0, speed: 780.0, life: 0.83, energy: 1.5,
                color: 0xff3344, len: 3.4, width: 0.2, spread: 0.002, sfx: Laser))),
        Cannon: (name: "机炮", cat: Weapon, mass: 2.0, hp: 22.0, cost: 10.0, color: 0x7c7468,
            info: "高射速散布弹幕。",
            weapon: Some((kind: Kinetic, rate: 9.0, dmg: 4.0, speed: 630.0, life: 0.97, energy: 0.4,
                color: 0xffd040, len: 1.8, width: 0.15, spread: 0.012, sfx: Cannon))),
        Plasma: (name: "等离子炮", cat: Weapon, mass: 3.0, hp: 26.0, cost: 11.5, color: 0x6d7f74,
            info: "弹速慢、伤害高，命中后小范围爆炸。很耗能量。",
            weapon: Some((kind: Energy, rate: 1.1, dmg: 32.0, speed: 450.0, life: 1.53, energy: 9.0,
                color: 0x44ff99, len: 1.2, width: 1.1, splash: 1.8, sfx: Plasma))),
        Missile: (name: "导弹舱", cat: Weapon, mass: 2.5, hp: 24.0, cost: 13.0, color: 0x8c8f96,
            info: "锁定目标后右键发射追踪导弹，范围伤害。",
            weapon: Some((kind: Explosive, rate: 0.45, dmg: 32.0, speed: 210.0, life: 5.0, energy: 8.0,
                color: 0xfff2e0, len: 1.6, width: 0.36, splash: 2.4, homing: true, sfx: Missile))),
        Reactor: (name: "反应堆", cat: System, mass: 3.0, hp: 30.0, cost: 8.0, color: 0x6e6a5c, energy_cap: 60.0, energy_regen: 12.0,
            info: "提高能量上限和回复速度。"),
        Shield: (name: "护盾发生器", cat: System, mass: 3.0, hp: 30.0, cost: 10.0, color: 0x5f6e86, shield_cap: 40.0, shield_regen: 5.0,
            info: "3 秒未受伤后自动回复，先于车体吸收伤害。"),
        Frame: (name: "骨架", cat: Structure, mass: 0.4, hp: 10.0, cost: 0.5, color: 0x9aa4b0,
            info: "很轻的空心骨架：搭支架、把武器架高几乎不增加重量，但不耐打。"),
        Lamp: (name: "灯块", cat: Structure, mass: 0.3, hp: 8.0, cost: 0.5, color: 0x7fe0ff,
            info: "装饰用，按涂装颜色发光。很轻，也很脆。"),
        Thruster: (name: "小推进器", cat: Mobility, mass: 0.8, hp: 12.0, cost: 2.5, color: 0x6b7380, thrust: 10.0,
            info: "小号推进器：推力只有推进器的四成，但轻、便宜。尾喷口正后方必须空着。"),
        Railgun: (name: "轨道炮", cat: Weapon, mass: 3.0, hp: 24.0, cost: 13.0, color: 0x6e7a88,
            info: "弹速极快、射程最远的穿甲弹，一发能连穿几个方块（伤害依次递减）。射速慢，很耗能量。",
            weapon: Some((kind: Pierce, rate: 0.6, dmg: 45.0, speed: 1500.0, life: 0.63, energy: 15.0,
                color: 0x9fe8ff, len: 7.0, width: 0.12, pierce: 3, sfx: Rail))),
        Flak: (name: "霰弹炮", cat: Weapon, mass: 2.0, hp: 22.0, cost: 10.0, color: 0x7a6e60,
            info: "一次打出一把散开的弹丸，贴脸威力大，射程短。",
            weapon: Some((kind: Kinetic, rate: 1.5, dmg: 4.0, speed: 570.0, life: 0.47, energy: 3.0,
                color: 0xffb060, len: 0.9, width: 0.16, spread: 0.06, pellets: 7, sfx: Flak))),
        Capacitor: (name: "电容", cat: System, mass: 1.5, hp: 18.0, cost: 4.0, color: 0x5c6f78, energy_cap: 90.0,
            info: "提高能量上限，但不回复能量。让武器和加速能连续用得更久。"),
        Wheel: (name: "车轮", cat: Move, mass: 1.0, hp: 26.0, cost: 2.5, color: 0x8d96a3,
            info: "标准的转向轮，自带动力。装在重心前面的会转向，后面的只管推。至少要 3 个轮子着地；被打掉一个，车就会跛。",
            drive: Some((radius: 0.9, power: 8.0, top: 39.0, grip: 1.3, steer: 0.8))),
        SmallWheel: (name: "小轮", cat: Move, mass: 0.6, hp: 16.0, cost: 1.5, color: 0x8d96a3,
            info: "能转向，又轻又快，打方向最灵；但抓地差、底盘低，过不了大坎。适合轻型侦察车。",
            drive: Some((radius: 0.65, power: 5.0, top: 49.0, grip: 1.0, steer: 0.9))),
        BigWheel: (name: "越野轮", cat: Move, mass: 2.2, hp: 44.0, cost: 4.0, color: 0x8d96a3,
            info: "能转向的大轮子：抓地强、劲大、底盘高，爬坡和翻石头容易，但跑不快，转弯半径也大。",
            drive: Some((radius: 1.25, power: 13.0, top: 33.0, grip: 1.7, steer: 0.65))),
        Hover: (name: "悬浮器", cat: Move, mass: 1.2, hp: 20.0, cost: 5.0, color: 0x5c6f78,
            info: "把车托离地面，自己不往前走：要配推进器，按 W 推着走。转弯特别快，但没有轮胎抓地，会侧滑，松开油门还会滑出很远；按 S 放下裙边刹车，停住后继续按住会慢慢倒车。一直耗能量，能量耗尽就落到地上。",
            drive: Some((radius: 1.0, hover: true, drain: 3.5, turn: 3.0))),
        DualWheel: (name: "双胎轮", cat: Move, mass: 1.8, hp: 40.0, cost: 3.0, color: 0x8d96a3,
            info: "两条轮胎并排的驱动轮：不能转向，但推力和抓地都比车轮强，也更耐打，适合装在车尾。整车都没有转向轮时，靠左右两侧一快一慢来转弯，像坦克一样，原地也能掉头。",
            drive: Some((radius: 0.9, power: 11.0, top: 37.0, grip: 1.8))),
        GiantWheel: (name: "巨轮", cat: Move, mass: 3.6, hp: 64.0, cost: 6.0, color: 0x8d96a3,
            info: "直径三格多的大块头：不能转向，劲最大、底盘最高，什么坎都压得过去，但又重又慢。前后两个之间至少空出 3 格。",
            drive: Some((radius: 1.6, power: 19.0, top: 31.0, grip: 2.0))),
        // close quarters: saws and flippers work straight ahead and need the cell in front clear
        Ram: (name: "撞角", cat: Weapon, mass: 3.5, hp: 70.0, cost: 4.0, color: 0x7a7f88, armor: 6.0,
            info: "楔形的钢撞角。撞车时接触点在撞角附近，给对方的伤害 ×3，自己只受 1/4；防机炮、霰弹也很硬。装在车头最管用。",
            melee: Some((kind: Ram, reach: 1.6, dmg: 3.0, guard: 0.25))),
        Saw: (name: "电锯", cat: Weapon, mass: 2.0, hp: 30.0, cost: 9.0, color: 0x8a8f99,
            info: "一直在转的圆锯：正前方贴着的敌车方块每秒受 70 点伤害，专切轮子和炮塔。正前方那一格必须空着。",
            melee: Some((kind: Saw, reach: 1.3, dmg: 70.0))),
        Flipper: (name: "翻板", cat: Weapon, mass: 2.5, hp: 40.0, cost: 8.0, color: 0x6f7a6a,
            info: "按 E 猛地掀起：正前方 2.5 m 内的敌车被抛起来，轻的车会被掀翻，正好推进深坑。每次耗 15 能量，3 秒冷却。正前方那一格必须空着。",
            melee: Some((kind: Flipper, reach: 2.5, dmg: 12.0, energy: 15.0, cooldown: 3.0, lift: 9.0, push: 6.0))),
        // gadgets: each on a key of its own; however many of a kind a vehicle has, they go off
        // together
        JumpJet: (name: "跳跃喷口", cat: Gadget, mass: 1.5, hp: 20.0, cost: 2.0, color: 0x6b7380,
            info: "按 Q 朝下猛喷一下，把车弹起来：跳上高台、飞过深坑、甩开追兵。装得越多跳得越高，重车要多装几个。每个耗 12 能量，4 秒冷却。喷口朝下，正下方必须空着。",
            gadget: Some((kind: Jump, energy: 12.0, cooldown: 4.0, power: 250.0))),
        MineLayer: (name: "布雷器", cat: Gadget, mass: 2.0, hp: 26.0, cost: 6.0, color: 0x6a6f5c,
            info: "按 G 在车尾放一颗地雷，1 秒后布好：敌车开到 3.5 m 内就炸，70 点范围伤害。每辆车最多同时留 3 颗，多放就收走最早那颗；每颗留 45 秒。耗 10 能量，2.5 秒冷却。",
            gadget: Some((kind: Mine, energy: 10.0, cooldown: 2.5, reach: 3.5, dmg: 70.0, radius: 3.0, secs: 45.0, count: 3))),
        Smoke: (name: "烟雾弹", cat: Gadget, mass: 1.5, hp: 20.0, cost: 5.0, color: 0x7a7f88,
            info: "按 X 在车周围放出一团 14 m 宽的浓烟，挂 8 秒：隔着烟锁定不了，追来的导弹看不见目标就直飞出去，AI 也看不见烟里的车。耗 15 能量，15 秒冷却。",
            gadget: Some((kind: Smoke, energy: 15.0, cooldown: 15.0, radius: 7.0, secs: 8.0))),
    },
)
